---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ArrowRight from "reicon/icons/ArrowRight";
import Globe from "reicon/icons/Globe";

// Same people as "Meet the team" on https://github.com/sponsors/coollabsio
const team = [
  {
    name: "Andras Bacsai",
    github: "andrasbacsai",
    role: "Founder",
    bio: "Founder of coolLabs. Loves open source and simplicity. Builds Coolify, Jean and the rest in live streams.",
    website: "https://coollabs.io",
    x: "heyandras",
  },
  {
    name: "Peak",
    github: "peaklabs-dev",
    role: "Core developer",
    bio: "Full-time entrepreneur and core developer on Coolify.",
    x: "peaklabs_dev",
  },
  {
    name: "ShadowArcanist",
    github: "ShadowArcanist",
    role: "Docs & community",
    bio: "Maintains the product documentation, manages the Discord community and makes tutorials on YouTube.",
    website: "https://shadowarcanist.com",
  },
  {
    name: "Aditya Tripathi",
    github: "adiologydev",
    role: "Team member",
    bio: "Founder of Climactic and team member at coolLabs.",
    website: "https://adiology.dev",
    x: "AdityaTripathiD",
  },
];

const iconLink =
  "flex size-8 items-center justify-center rounded-md text-fg-faint transition-colors hover:bg-white/[0.06] hover:text-fg";
---

<Layout title="Team | coolLabs" description="Meet the people behind coolLabs, Coolify, Jean and our other open-source projects.">
  <h1 class="px-4 text-4xl font-semibold tracking-tight text-balance text-fg md:text-5xl">
    Meet the team<span class="text-warning">.</span>
  </h1>
  <p class="mx-auto mt-4 max-w-xl px-4 text-base text-pretty text-fg-dim">
    A small, self-funded team that builds open-source software for developers.
  </p>

  <div class="mx-auto mt-12 grid max-w-4xl gap-3 px-4 text-left sm:grid-cols-2">
    {
      team.map((person) => (
        <div class="card flex gap-4 p-5">
          <img
            src={`/images/team/${person.github.toLowerCase()}.webp`}
            alt={person.name}
            width="56"
            height="56"
            loading="lazy"
            class="size-14 shrink-0 rounded-full ring-1 ring-hairline"
          />
          <div class="min-w-0 flex-1">
            <h2 class="text-base font-semibold tracking-tight text-fg">{person.name}</h2>
            <p class="text-xs font-medium text-coollabs-50/70">{person.role}</p>
            <p class="mt-2 text-[13px] leading-5 text-fg-faint">{person.bio}</p>
            <div class="mt-3 -ml-2 flex items-center gap-1">
              <a href={`https://github.com/${person.github}`} target="_blank" rel="noopener" aria-label={`${person.name} on GitHub`} class={iconLink}>
                <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
              </a>
              {person.x && (
                <a href={`https://x.com/${person.x}`} target="_blank" rel="noopener" aria-label={`${person.name} on X`} class={iconLink}>
                  <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M13.6823 10.6218L20.2391 3H18.6854L12.9921 9.61788L8.44486 3H3.2002L10.0765 13.0074L3.2002 21H4.75404L10.7663 14.0113L15.5685 21H20.8131L13.6819 10.6218H13.6823ZM11.5541 13.0956L10.8574 12.0991L5.31391 4.16971H7.70053L12.1742 10.5689L12.8709 11.5655L18.6861 19.8835H16.2995L11.5541 13.096V13.0956Z" />
                  </svg>
                </a>
              )}
              {person.website && (
                <a href={person.website} target="_blank" rel="noopener" aria-label={`${person.name}'s website`} class={iconLink}>
                  <Icon icon={Globe} class="size-4" />
                </a>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mx-auto mt-16 max-w-xl px-4">
    <p class="text-sm text-fg-faint">
      The team is paid by sponsors, Cloud customers and merch buyers. No investors.
    </p>
    <a href="/sponsorships" class="btn btn-neutral mt-5">
      Support the team
      <Icon icon={ArrowRight} class="size-4" />
    </a>
  </div>
</Layout>
